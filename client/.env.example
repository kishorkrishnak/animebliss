# ==============================================================================
# AnimeBliss Environment Template (.env.example)
# Duplicate this file as '.env' and provide your custom values if needed.
# ==============================================================================

# Primary Consumet API Base URL
REACT_APP_CONSUMET_API_URL=https://consumet-instance-alpha.vercel.app

# Optional secondary API mirror. If omitted, requests use the primary URL.
# REACT_APP_CONSUMET_FALLBACK_URL=https://your-secondary-consumet-instance.example

# AniList Meta API URL
REACT_APP_ANILIST_API_URL=https://consumet-instance-alpha.vercel.app/meta/anilist

# Primary Anime Provider (animekai, gogoanime, zoro, etc.)
REACT_APP_CONSUMET_PROVIDER=animekai

# Supported Video & Server Providers
REACT_APP_PROVIDER_ANIMEKAI=animekai
REACT_APP_PROVIDER_ANIMEPAHE=animepahe
REACT_APP_PROVIDER_ANIMESATURN=animesaturn
REACT_APP_PROVIDER_ANIMEUNITY=animeunity
REACT_APP_PROVIDER_HIANIME=hianime
REACT_APP_PROVIDER_KICKASSANIME=kickassanime

# Google OAuth Client ID (Optional)
REACT_APP_CLIENT_ID=658977310896-knrl3gka66fldh83dao2rhgbblmd4un9.apps.googleusercontent.com
